rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null
        && (!exists(/databases/$(database)/documents/profiles/$(request.auth.uid))
          || get(/databases/$(database)/documents/profiles/$(request.auth.uid)).data.get('blocked', false) != true);
    }
    function activePremium() {
      let subscription = /databases/$(database)/documents/premiumSubscriptions/$(request.auth.uid);
      return exists(subscription) && get(subscription).data.activeUntil > request.time;
    }
    function viewerHasFreeContactAccess() {
      let profile = /databases/$(database)/documents/profiles/$(request.auth.uid);
      return exists(profile) && (get(profile).data.gender != 'Man'
        || get(profile).data.get('disability', 'Normal person') != 'Normal person');
    }
    function eligibleMatch(uid) {
      let viewer = /databases/$(database)/documents/profiles/$(request.auth.uid);
      let target = /databases/$(database)/documents/profiles/$(uid);
      return signedIn() && exists(viewer) && exists(target)
        && get(target).data.religion == get(viewer).data.religion
        && (get(viewer).data.get('disability', 'Normal person') == 'Normal person'
          || get(target).data.get('disability', 'Normal person') != 'Normal person');
    }
    function acceptedMatch(otherUid) {
      let sent = /databases/$(database)/documents/interests/$(request.auth.uid + '_' + otherUid);
      let received = /databases/$(database)/documents/interests/$(otherUid + '_' + request.auth.uid);
      return (exists(sent) && get(sent).data.status == 'accepted')
        || (exists(received) && get(received).data.status == 'accepted');
    }

    match /profiles/{uid} {
      allow get: if signedIn() && (request.auth.uid == uid || eligibleMatch(uid));
      allow list: if false;
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.disability is string
        && request.resource.data.gender in ['Man', 'Woman']
        && request.resource.data.get('about', '') is string
        && request.resource.data.get('about', '').size() <= 200
        && request.resource.data.get('about', '').matches('^[^0-9]*$')
        && request.resource.data.get('blocked', false) == false;
      allow update: if signedIn() && request.auth.uid == uid
        && request.resource.data.gender == resource.data.gender
        && request.resource.data.disability is string
        && request.resource.data.get('about', '') is string
        && request.resource.data.get('about', '').size() <= 200
        && request.resource.data.get('about', '').matches('^[^0-9]*$')
        && request.resource.data.get('blocked', false) == resource.data.get('blocked', false);
      allow delete: if false;
    }

    match /privateProfiles/{uid} {
      allow get: if signedIn()
        && (request.auth.uid == uid
          || (eligibleMatch(uid) && (activePremium()
            || (acceptedMatch(uid) && viewerHasFreeContactAccess()))));
      allow list: if false;
      allow create, update: if signedIn() && request.auth.uid == uid;
      allow delete: if signedIn() && request.auth.uid == uid;
    }

    match /premiumSubscriptions/{uid} {
      allow get: if signedIn() && request.auth.uid == uid;
      allow list, create, update, delete: if false;
    }

    match /premiumRequests/{uid} {
      allow read, write: if false;
    }

    match /interests/{interestId} {
      // A missing deterministic interest document is safe to read; it contains no data.
      // This lets clients check a pair's interest before creating or viewing contacts.
      allow get: if signedIn() && (resource == null
        || resource.data.senderUid == request.auth.uid
        || resource.data.recipientUid == request.auth.uid);
      allow list: if signedIn()
        && (resource.data.senderUid == request.auth.uid
          || resource.data.recipientUid == request.auth.uid);
      allow create: if signedIn()
        && request.resource.data.senderUid == request.auth.uid
        && request.resource.data.recipientUid is string
        && request.resource.data.recipientUid != request.auth.uid
        && request.resource.data.status == 'pending'
        && eligibleMatch(request.resource.data.recipientUid);
      allow update: if signedIn()
        && resource.data.recipientUid == request.auth.uid
        && resource.data.status == 'pending'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'respondedAt'])
        && request.resource.data.senderUid == resource.data.senderUid
        && request.resource.data.recipientUid == resource.data.recipientUid
        && request.resource.data.status in ['accepted', 'rejected'];
      allow delete: if false;
    }
  }
}
