rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function activeUser() {
      return request.auth != null
        && (!firestore.exists(/databases/(default)/documents/profiles/$(request.auth.uid))
          || firestore.get(/databases/(default)/documents/profiles/$(request.auth.uid)).data.get('blocked', false) != true);
    }
    match /profilePhotos/{uid}/{fileName} {
      allow read: if activeUser();
      allow write: if activeUser()
        && request.auth.uid == uid
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|webp)');
    }
  }
}
